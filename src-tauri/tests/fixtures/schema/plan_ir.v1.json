{
  "$defs": {
    "AsymmetryPlan": {
      "additionalProperties": false,
      "properties": {
        "chorus_variation": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "deliberate_unrhymed": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "short_line": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "withholding": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "chorus_variation",
        "deliberate_unrhymed",
        "short_line",
        "withholding"
      ],
      "type": "object"
    },
    "DouyinClip": {
      "additionalProperties": false,
      "properties": {
        "end_section": {
          "type": "string"
        },
        "seconds": {
          "maximum": 15,
          "minimum": 15,
          "type": "integer"
        },
        "start_section": {
          "type": "string"
        }
      },
      "required": [
        "end_section",
        "seconds",
        "start_section"
      ],
      "type": "object"
    },
    "DouyinModeMeta": {
      "additionalProperties": false,
      "properties": {
        "clip": {
          "$ref": "#/$defs/DouyinClip"
        },
        "hook_line": {
          "type": "string"
        },
        "loop_tail": {
          "type": "boolean"
        },
        "scene": {
          "$ref": "#/$defs/DouyinScene"
        },
        "scene_source": {
          "$ref": "#/$defs/SceneSource"
        }
      },
      "required": [
        "clip",
        "hook_line",
        "loop_tail",
        "scene",
        "scene_source"
      ],
      "type": "object"
    },
    "DouyinScene": {
      "oneOf": [
        {
          "const": "emotion",
          "type": "string"
        },
        {
          "const": "daily",
          "type": "string"
        },
        {
          "const": "dance",
          "type": "string"
        },
        {
          "const": "story",
          "type": "string"
        },
        {
          "const": "guofeng",
          "type": "string"
        }
      ]
    },
    "GlobalStyle": {
      "additionalProperties": false,
      "properties": {
        "arc": {
          "type": [
            "string",
            "null"
          ]
        },
        "arrangement_hook": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "bpm": {
          "maximum": 220,
          "minimum": 40,
          "type": [
            "integer",
            "null"
          ]
        },
        "genre": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "instruments": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "meter": {
          "type": [
            "string",
            "null"
          ]
        },
        "mix": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mood": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "negative": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "vocal": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "arc",
        "arrangement_hook",
        "bpm",
        "genre",
        "instruments",
        "key",
        "meter",
        "mix",
        "mood",
        "negative",
        "vocal"
      ],
      "type": "object"
    },
    "LyricLang": {
      "enum": [
        "zh",
        "en"
      ],
      "type": "string"
    },
    "ModeMeta": {
      "additionalProperties": false,
      "properties": {
        "douyin": {
          "anyOf": [
            {
              "$ref": "#/$defs/DouyinModeMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lyrics_lang": {
          "$ref": "#/$defs/LyricLang"
        }
      },
      "required": [
        "douyin",
        "lyrics_lang"
      ],
      "type": "object"
    },
    "PlotType": {
      "oneOf": [
        {
          "const": "attitudinal",
          "type": "string"
        },
        {
          "const": "situational",
          "type": "string"
        },
        {
          "const": "narrative",
          "type": "string"
        },
        {
          "const": "expository",
          "type": "string"
        }
      ]
    },
    "SceneSource": {
      "enum": [
        "user",
        "default"
      ],
      "type": "string"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "energy": {
          "maximum": 10,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "instruments": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/SectionKind"
        },
        "label": {
          "type": "string"
        },
        "lines": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "minimal": {
          "type": "boolean"
        },
        "motion": {
          "anyOf": [
            {
              "$ref": "#/$defs/SectionMotion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "negative_local": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "positive_local": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "subtraction": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "target_seconds": {
          "maximum": 600,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "energy",
        "instruments",
        "kind",
        "label",
        "lines",
        "minimal",
        "motion",
        "negative_local",
        "positive_local",
        "subtraction",
        "target_seconds"
      ],
      "type": "object"
    },
    "SectionKind": {
      "enum": [
        "intro",
        "verse",
        "pre_chorus",
        "chorus",
        "hook",
        "post_chorus",
        "bridge",
        "interlude",
        "drop",
        "breakdown",
        "outro",
        "end"
      ],
      "type": "string"
    },
    "SectionMotion": {
      "oneOf": [
        {
          "const": "push",
          "type": "string"
        },
        {
          "const": "stop",
          "type": "string"
        }
      ]
    },
    "SongIntent": {
      "additionalProperties": false,
      "properties": {
        "anchor_object": {
          "type": "string"
        },
        "at_what_moment": {
          "type": "string"
        },
        "one_thing": {
          "type": "string"
        },
        "plot_type": {
          "$ref": "#/$defs/PlotType"
        },
        "rhyme_plan": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "to_whom": {
          "type": "string"
        }
      },
      "required": [
        "anchor_object",
        "at_what_moment",
        "one_thing",
        "plot_type",
        "rhyme_plan",
        "to_whom"
      ],
      "type": "object"
    },
    "SongPlan": {
      "additionalProperties": false,
      "properties": {
        "asymmetry": {
          "anyOf": [
            {
              "$ref": "#/$defs/AsymmetryPlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exemptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "global": {
          "$ref": "#/$defs/GlobalStyle"
        },
        "intent": {
          "anyOf": [
            {
              "$ref": "#/$defs/SongIntent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mode_meta": {
          "$ref": "#/$defs/ModeMeta"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "persona": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "pronunciation_hints": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "type": "array"
        },
        "series_context": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "settings": {
          "$ref": "#/$defs/SunoSettings"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "asymmetry",
        "exemptions",
        "global",
        "intent",
        "mode_meta",
        "notes",
        "persona",
        "pronunciation_hints",
        "schema_version",
        "sections",
        "series_context",
        "settings",
        "title"
      ],
      "type": "object"
    },
    "SunoSettings": {
      "additionalProperties": false,
      "properties": {
        "audio_influence": {
          "maximum": 100,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reference_audio": {
          "default": false,
          "type": "boolean"
        },
        "style_influence": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        "variety": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        "vocal_gender": {
          "anyOf": [
            {
              "$ref": "#/$defs/VocalGender"
            },
            {
              "type": "null"
            }
          ]
        },
        "weirdness": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "audio_influence",
        "reference_audio",
        "style_influence",
        "variety",
        "vocal_gender",
        "weirdness"
      ],
      "type": "object"
    },
    "VocalGender": {
      "enum": [
        "male",
        "female"
      ],
      "type": "string"
    }
  },
  "$ref": "#/$defs/SongPlan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlanIr"
}
